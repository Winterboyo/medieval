{
  "name": "medieval-land",
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$path": "src/server"
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,

      "BuildWorld": {
        "$path": "scripts/build-world.luau"
      },

      "Layout": {
        "$path": "layout.json"
      },

      "Events": {
        "$className": "Folder",
        "SpecialistStolen": {
          "$className": "BindableEvent"
        },
        "MessengerStruck": {
          "$className": "BindableEvent"
        },
        "ReputationDelta": {
          "$className": "BindableEvent"
        },
        "SpecialistSet": {
          "$className": "BindableEvent"
        }
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,

      "Shared": {
        "$path": "src/shared"
      },

      "Remotes": {
        "$className": "Folder",
        "Notify": {
          "$className": "RemoteEvent"
        },
        "NegotiationState": {
          "$className": "RemoteEvent"
        },
        "NegotiationAct": {
          "$className": "RemoteEvent"
        },
        "VaultDeposit": {
          "$className": "RemoteEvent"
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/client"
      }
    }
  }
}
